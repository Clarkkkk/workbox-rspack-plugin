{
  "name": "@aaroon/workbox-rspack-plugin",
  "description": "An Rspack plugin to use workbox",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Aaron Zhou",
  "keywords": [
    "workbox",
    "rspack",
    "rsbuild",
    "workbox-webpack-plugin",
    "pwa",
    "service worker",
    "manifest"
  ],
  "homepage": "https://github.com/Clarkkkk/workbox-rspack-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clarkkkk/workbox-rspack-plugin"
  },
  "bugs": {
    "url": "https://github.com/Clarkkkk/workbox-rspack-plugin/issues"
  },
  "packageManager": "pnpm@10.33.4",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "analyze": "vite-bundle-visualizer",
    "test": "vitest",
    "test:dist": "node test/node/cjs-config-smoke.mjs",
    "test:update": "vitest --update",
    "test:run": "vitest --run --changed",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "format": "eslint --fix --cache src/**/*.ts",
    "prepare": "husky install",
    "uninstall-husky": "npm uninstall husky --no-save && git config --unset core.hooksPath && npx rimraf .husky",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0",
    "pathe": "^1.1.2",
    "pretty-bytes": "^6.1.1",
    "workbox-build": "^7.4.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0",
    "@rspack/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^2.0.3",
    "@rspack/core": "^2.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "commit-and-tag-version": "^12.7.3",
    "conventional-changelog-aaron-preset": "^0.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fs-extra": "^11.3.5",
    "globals": "^17.6.0",
    "globby": "^16.2.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "memfs": "^4.57.2",
    "module-alias": "^2.3.4",
    "prettier": "^3.8.3",
    "rollup-plugin-node-externals": "^9.0.1",
    "service-worker-mock": "^2.0.5",
    "tempy": "^3.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6",
    "webpack": "^5.106.2",
    "workbox-precaching": "^7.4.1"
  }
}
